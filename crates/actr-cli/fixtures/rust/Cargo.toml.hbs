[package]
name = "{{PROJECT_NAME}}"
version = "0.1.0"
edition = "2024"

[lib]
name = "{{PROJECT_NAME_SNAKE}}_guest"
crate-type = ["cdylib", "rlib"]

[[bin]]
name = "{{PROJECT_NAME}}"
path = "src/main.rs"

[dependencies]
actr-config = "{{ACTR_WORKLOAD_VERSION}}"
actr-framework = "{{ACTR_WORKLOAD_VERSION}}"
actr-hyper = { version = "{{ACTR_WORKLOAD_VERSION}}", features = ["wasm-engine"] }
actr-protocol = "{{ACTR_WORKLOAD_VERSION}}"
async-trait = "0.1"
anyhow = "1"
base64 = "0.22"
bytes = "1"
prost = "0.14"
prost-types = "0.14"
serde_json = "1"
tokio = { version = "1", features = ["full"] }
tracing = "0.1"

# Cargo applies overrides only from the consumer's workspace root.
[workspace]

[patch.crates-io]
webrtc = { git = "https://github.com/webrtc-rs/webrtc", rev = "8ea6e2a69b0c4c97f38b0e81e5a77e1c066f3757" }
rtc = { git = "https://github.com/webrtc-rs/webrtc", rev = "8ea6e2a69b0c4c97f38b0e81e5a77e1c066f3757" }
rtc-turn = { git = "https://github.com/webrtc-rs/webrtc", rev = "8ea6e2a69b0c4c97f38b0e81e5a77e1c066f3757" }
rtc-rtp = { git = "https://github.com/webrtc-rs/webrtc", rev = "8ea6e2a69b0c4c97f38b0e81e5a77e1c066f3757" }
